# NrNMusic backend (backend/app/config.py). Copy to backend/.env and edit.

# HTTP listener
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info

# YouTube Music locale
YT_REGION=US
YT_LANGUAGE=en

# Dev only: Vite dev server origins plus the Android (Capacitor) WebView
# origins. In production serve the built SPA from the backend (same origin).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,capacitor://localhost,https://localhost,http://localhost

# Cache lifetimes (seconds)
METADATA_CACHE_TTL=300
STREAM_CACHE_TTL=1800
CACHE_MAX_ENTRIES=512
STREAM_REFRESH_MARGIN=120

# Upstream timeouts (seconds)
UPSTREAM_TIMEOUT=15
STREAM_RESOLVE_TIMEOUT=30

# Requests per minute per client IP (0 disables the limiter).
RATE_LIMIT_PER_MINUTE=240

# Stream delivery: proxy=1 keeps audio same-origin (CORS-safe), redirect=1 lets
# the browser fetch googlevideo.com directly when proxy_stream=0.
PROXY_STREAM=1
ENABLE_STREAM_REDIRECT=1
